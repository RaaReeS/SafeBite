# Copia este archivo a apps/web/.env.local (web) o apps/mobile/.env (mobile)
# y rellena los valores. Nunca subas los archivos con valores reales al repositorio.
#
# En local, `pnpm db:start` muestra la URL y la clave publishable.

# Web (Next.js)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# URL pública de la web, sin barra final (QR y emails). En local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=

# Mobile (Expo)
# En local: http://127.0.0.1:54321. En desarrollo la app cambia sola 127.0.0.1 por la
# IP del PC en la red (la que ve Expo Go), así que no hay que tocarlo al cambiar de wifi.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Web de SafeBite (términos y privacidad). En local: http://127.0.0.1:3000
EXPO_PUBLIC_SITE_URL=

# Solo servidor. Nunca en el cliente ni con prefijo NEXT_PUBLIC_/EXPO_PUBLIC_.
# El panel web no la usa.
SUPABASE_SECRET_KEY=

# Importar la carta con IA (solo servidor; nunca con prefijo NEXT_PUBLIC_).
# Clave gratis de Groq (console.groq.com). Activa «Zero Data Retention» en Data Controls.
GROQ_API_KEY=
# Opcional: modelo con visión (por defecto qwen/qwen3.8-27b).
GROQ_MODEL=
