# Copia este archivo a .env.local (web) o .env (mobile) y rellena los valores.
# Nunca subas los archivos con valores reales al repositorio.

# Web (Next.js)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Mobile (Expo)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Solo servidor. Nunca en el cliente ni con prefijo NEXT_PUBLIC_/EXPO_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
